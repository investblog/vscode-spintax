// SYNTAX TEST "source.spintax" "core constructs"

  {a|b} %x%
//^ punctuation.section.braces.begin.spintax
//  ^ punctuation.separator.spintax
//    ^ punctuation.section.braces.end.spintax
//      ^^^ variable.other.spintax

  #set %v% = x
//^^^^ keyword.control.directive.set.spintax
//     ^^^ entity.name.variable.spintax
//         ^ keyword.operator.assignment.spintax

  #def %v% = x
//^^^^ keyword.control.directive.def.spintax
//     ^^^ entity.name.variable.spintax
//         ^ keyword.operator.assignment.spintax

  #def %v% =
//^^^^ keyword.control.directive.def.spintax
//     ^^^ entity.name.variable.spintax
//         ^ keyword.operator.assignment.spintax

  #define %v% = x
//^^^^^^^ - keyword.control.directive.def.spintax

  #def %v = x
//^^^^ - keyword.control.directive.def.spintax

  text #def %v% = x
//     ^^^^ - keyword.control.directive.def.spintax

  #DEF %v% = x
//^^^^ - keyword.control.directive.def.spintax

  {alpha|
//^ punctuation.section.braces.begin.spintax
  #def %inner% = ZZZ
//^^^^ keyword.control.directive.def.spintax
//     ^^^^^^^ entity.name.variable.spintax
  beta}

  #include "s"
//^^^^^^^^ keyword.control.directive.include.spintax
//         ^^^ string.quoted.double.include.spintax

  /# c #/#set %x% = 1
//^^ punctuation.definition.comment.begin.spintax
//   ^ comment.block.spintax
//       ^^^^ keyword.control.directive.set.spintax
//            ^^^ entity.name.variable.spintax
//                ^ keyword.operator.assignment.spintax

  /# c #/ #def %v% = x
//        ^^^^ keyword.control.directive.def.spintax

  /# a #/ text /# b #/#set %x% = 1
//                    ^^^^ - keyword.control.directive.set.spintax

/# c #/#set %x% = 1
// <- punctuation.definition.comment.begin.spintax
//     ^^^^ keyword.control.directive.set.spintax

  /# hi #/
//^^ punctuation.definition.comment.begin.spintax
//   ^ comment.block.spintax
